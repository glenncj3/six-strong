[gd_scene load_steps=5 format=3 uid="uid://purchasable_tile_scene"]

[ext_resource type="Script" path="res://scenes/components/purchasable_tile.gd" id="1_script"]
[ext_resource type="PackedScene" uid="uid://gold_cost_icon" path="res://scenes/components/gold_cost_icon.tscn" id="2_gold_cost"]

[sub_resource type="Shader" id="Shader_haze"]
code = "shader_type canvas_item;

uniform float opacity : hint_range(0.0, 1.0) = 0.85;
uniform float vertical_squeeze : hint_range(1.0, 4.0) = 2.2;

void fragment() {
	vec2 uv = UV - vec2(0.5);
	uv.y *= vertical_squeeze;
	float d = length(uv);
	float alpha = smoothstep(0.5, 0.05, d) * opacity;
	COLOR = vec4(0.0, 0.0, 0.0, alpha);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_haze"]
shader = SubResource("Shader_haze")

[node name="PurchasableTile" type="PanelContainer"]
